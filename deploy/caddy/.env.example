VS_ORG_NAME=Example Corp
VS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VS_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
VS_MANIFEST_PRUNE=false
